# 复制为 .env 后填写；.env 已被 .gitignore 忽略
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# auto: 有 Key 走真实模型，无 Key 自动降级演示引擎；1 强制演示；0 强制真实
MOCK_LLM=auto
LLM_RETRIES=2
LLM_BACKOFF=0.8
LLM_DEGRADE_AFTER=3

# 会话持久化（SQLite 文件路径，相对 backend/）
DB_PATH=data/resumepilot.db

# 扫描件 OCR
OCR_ENABLED=1
OCR_MIN_CHARS=50
OCR_DPI=200
OCR_MAX_PAGES=8
OCR_LANG=chi_sim+eng
OCR_BANDING=1
# TESSERACT_CMD=C:/Program Files\Tesseract-OCR\tesseract.exe

RAG_ENABLED=1
MAX_UPLOAD_MB=10

# --- 用户体系（JWT） ---
# 留空时自动生成并持久化到 data/.jwt_secret（重启不会把用户踢下线）
JWT_SECRET=
JWT_TTL_HOURS=168

# --- 模拟投递（SMTP） ---
# 留空则走「演示模式」：邮件与 PDF 连同 .eml 落到 data/outbox/，前端可下载
# QQ 邮箱：smtp.qq.com / 465 / 授权码（不是登录密码）
# 163 邮箱：smtp.163.com / 465 / 授权码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=ResumePilot Pro
SMTP_SSL=1
